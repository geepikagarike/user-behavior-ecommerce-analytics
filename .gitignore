# Python bytecode and tooling caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local environment variables and secrets
.env
.env.*
!.env.example

# Downloaded and generated datasets
data/raw/*
data/processed/*
data/cleaned/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/daily_activity.csv
!data/processed/event_summary.csv
!data/processed/funnel_stages.csv
!data/cleaned/.gitkeep

# Local databases
*.db
*.sqlite
*.sqlite3

# Jupyter temporary files
.ipynb_checkpoints/

# VS Code user-specific settings
.vscode/*
!.vscode/extensions.json

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
